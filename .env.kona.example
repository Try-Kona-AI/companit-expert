# Kona AI credentials for this project only. Copy to .env.kona (gitignored) and
# fill in. Sourcing this file scopes every CLI call below to Kona accounts
# without touching the CYMBUL logins stored in the macOS keychain.

# github.com > Try-Kona-AI account > Settings > Developer settings > tokens
# classic token, scopes: repo
GH_TOKEN=

# supabase.com > Account > Access Tokens (signed in as the Kona AI account)
SUPABASE_ACCESS_TOKEN=

# vercel.com > Account Settings > Tokens (signed in as the Kona AI account)
# scope the token to the Kona team
VERCEL_TOKEN=

# Filled in after the project exists
KONA_SUPABASE_REF=
KONA_VERCEL_SCOPE=
